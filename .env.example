# Configuración opcional de Audio-Bot (Termux / Node.js)

# Número de WhatsApp con código de país (sin +, espacios ni guiones), p. ej.: 59899123456
# Si se deja vacío, el bot lo pedirá por consola al iniciar por primera vez.
PHONE_NUMBER=

# Comando para convertir video a sticker con audio
COMMAND=.s2

# Comando para ver la onda de sonido y escuchar el audio de un sticker
AUDIO_COMMAND=.audio

# Metadatos del paquete de stickers (visibles al tocar el sticker en WhatsApp)
STICKER_PACK=Made by
STICKER_AUTHOR=@Lyan

# Duración máxima del video/audio en segundos (por defecto: 10)
MAX_SECONDS=10

# Tamaño máximo del WebP animado en bytes (por defecto: 900000 ~ 900 KB)
MAX_WEBP_BYTES=900000

# Permitir usar el comando desde la propia cuenta vinculada (true/false)
ALLOW_SELF=true

# Carpeta donde se guarda la sesión vinculada
AUTH_DIR=./auth_info

# Carpeta temporal para conversiones con FFmpeg
TMP_DIR=./tmp

# Nivel de logs de Baileys (silent, fatal, error, warn, info, debug)
LOG_LEVEL=silent
